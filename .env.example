# HundunOS 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ============================================================================
# 基础配置
# ============================================================================
NODE_ENV=development
HUNDUNOS_VERSION=3.6.0
HUNDUNOS_NAME=HundunOS

# ============================================================================
# 内核配置
# ============================================================================
HUNDUNOS_LOG_LEVEL=info
HUNDUNOS_MAX_RETRIES=3
HUNDUNOS_TIMEOUT=30000
HUNDUNOS_DEBUG=false
HUNDUNOS_WORKSPACE=.
HUNDUNOS_PYTHON_PATH=python
HUNDUNOS_NODE_PATH=node

# ============================================================================
# 模型路由器配置
# ============================================================================
MODEL_ROUTER_STRATEGY=COST_FIRST
MODEL_ROUTER_LOCAL_FIRST=true
MODEL_REQUEST_TIMEOUT=30000

# 本地模型 (Ollama)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_MAX_TOKENS=8192

# 熔断器配置
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic 配置
ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GLM 配置
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_DEFAULT_MODEL=glm-4-flash

# ============================================================================
# REST API 配置
# ============================================================================
REST_API_PORT=38080
REST_API_RATE_LIMIT_ENABLED=true
REST_API_RATE_LIMIT_WINDOW=60000
REST_API_RATE_LIMIT_MAX=60
REST_API_RATE_LIMIT_BURST_MAX=10

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:38080,http://127.0.0.1:38080
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-API-Key

# ============================================================================
# 存储配置
# ============================================================================
STORAGE_TYPE=json
STORAGE_PATH=./data
STORAGE_ENCRYPT_BACKUPS=false
STORAGE_BACKUP_RETENTION_DAYS=7
STORAGE_MAX_BACKUPS=10

# SQLite 配置
SQLITE_DATABASE_PATH=./data/hundunos.db
SQLITE_POOL_SIZE=3

# PostgreSQL 配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=hundunos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ============================================================================
# 平台配置
# ============================================================================
PLATFORM_OS=windows
PLATFORM_WORKSPACE=.
PLATFORM_PYTHON_PATH=python
PLATFORM_NODE_PATH=node

# ============================================================================
# 消息总线配置
# ============================================================================
MESSAGE_BUS_ACK_TIMEOUT=5000
MESSAGE_BUS_MAX_RETRIES=3
MESSAGE_BUS_PERSISTENCE_ENABLED=false

# ============================================================================
# 工具桥接配置
# ============================================================================
TOOL_BRIDGE_TOOLS_DIR=./scripts/tools
TOOL_BRIDGE_TIMEOUT=30000
TOOL_BRIDGE_SANDBOX_ENABLED=true

# ============================================================================
# 技能配置
# ============================================================================
SKILLS_ENABLED=true
SKILLS_DIRS=./.claude/skills,./skills
SKILLS_HOT_RELOAD=false

# ============================================================================
# 日志配置
# ============================================================================
LOGGING_LEVEL=info
LOGGING_FORMAT=pretty
LOGGING_COLORS=true
LOGGING_FILE_PATH=./logs/hundunos.log
LOGGING_STRUCTURED=false

# ============================================================================
# Rust 模块配置
# ============================================================================
RUST_MODULES_ENABLED=true
RUST_MODULES_MODE=auto
RUST_MODULES_TCP_PORT=38082
RUST_MODULES_SOCKET_PATH=\\\\.\\pipe\\hundunos
RUST_MODULES_FALLBACK_TO_JS=true
RUST_MODULES_HEALTH_CHECK_INTERVAL=30000

# ============================================================================
# 安全配置
# ============================================================================
HEALTH_MONITOR_ENABLED=true
PERMISSION_MODE=default
AUDIT_LOGGING_ENABLED=true
PERMISSION_GATING_ENABLED=true
PRIVACY_SHIELD_ENABLED=true
