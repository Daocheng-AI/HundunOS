{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\Lin\\.qclaw\\workspace\\hundunos"
      ]
    },
    "brave-search": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "env": {
        "BRAVE_API_KEY": ""
      }
    },
    "github": {
      "command": "uvx",
      "args": [
        "mcp-server-github",
        "--personal-access-token",
        "YOUR_GITHUB_PAT_HERE"
      ],
      "env": {}
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "C:\\Users\\Lin\\.qclaw\\workspace\\hundunos"
      ]
    },
    "postgres": {
      "command": "uvx",
      "args": [
        "mcp-server-postgres",
        "postgresql://user:password@localhost:5432/dbname"
      ]
    },
    "sqlite": {
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "C:\\Users\\Lin\\.qclaw\\workspace\\hundunos\\test.db"
      ]
    },
    "slack": {
      "command": "uvx",
      "args": [
        "mcp-server-slack",
        "--bot-token",
        "xoxb-your-bot-token",
        "--app-level-token",
        "xapp-your-app-token"
      ]
    }
  }
}
