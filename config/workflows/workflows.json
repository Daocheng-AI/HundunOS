{
  "workflows": [
    {
      "name": "deep-interview",
      "description": "深度访谈 - Socratic 需求澄清 workflow",
      "keywords": ["deep interview", "interview", "don't assume", "clarify", "需求不清", "明确需求"],
      "trigger": "keyword",
      "priority": 100,
      "steps": [
        {
          "phase": "intake",
          "description": "收集上下文快照",
          "action": "context-snapshot"
        },
        {
          "phase": "interview",
          "description": "Socratic 提问循环",
          "action": "socratic-loop",
          "maxRounds": 12,
          "ambiguityThreshold": 0.2
        },
        {
          "phase": "crystallize",
          "description": "生成执行规格",
          "action": "generate-spec"
        }
      ],
      "outputs": [
        ".hundunos/specs/{task-slug}.md"
      ]
    },
    {
      "name": "ralplan",
      "description": "计划审批 - 结构化议事流程",
      "keywords": ["ralplan", "plan approval", "review plan", "审批计划"],
      "trigger": "keyword",
      "priority": 90,
      "steps": [
        {
          "phase": "prd",
          "description": "生成产品需求文档",
          "action": "generate-prd"
        },
        {
          "phase": "deliberation",
          "description": "结构化议事（权衡分析）",
          "action": "deliberation",
          "rounds": 3
        },
        {
          "phase": "test-spec",
          "description": "生成测试规格",
          "action": "generate-test-spec"
        },
        {
          "phase": "approval",
          "description": "审批通过",
          "action": "approval-gate"
        }
      ],
      "outputs": [
        ".hundunos/plans/prd-{slug}.md",
        ".hundunos/plans/test-spec-{slug}.md"
      ]
    },
    {
      "name": "ralph",
      "description": "持久循环 - 完成直到验证通过",
      "keywords": ["ralph", "don't stop", "keep going", "完成", "must complete"],
      "trigger": "keyword",
      "priority": 85,
      "maxIterations": 10,
      "steps": [
        {
          "phase": "execute",
          "description": "执行任务（并行子代理）",
          "action": "parallel-delegation"
        },
        {
          "phase": "verify",
          "description": "验证完成证据",
          "action": "verification",
          "required": true
        },
        {
          "phase": "architect-review",
          "description": "Architect 审批门",
          "action": "architect-approval",
          "tier": "standard"
        },
        {
          "phase": "deslop",
          "description": "AI 风格清理",
          "action": "ai-slop-cleaner"
        }
      ],
      "exitConditions": {
        "success": ["verification passed", "architect approved"],
        "failure": ["max iterations", "fundamental blocker"]
      }
    },
    {
      "name": "ultrawork",
      "description": "并行执行 - 多子代理同时工作",
      "keywords": ["ultrawork", "ulw", "parallel", "并行"],
      "trigger": "keyword",
      "priority": 80,
      "steps": [
        {
          "phase": "split",
          "description": "分解任务为独立子任务",
          "action": "task-split"
        },
        {
          "phase": "delegate",
          "description": "并行委托给子代理",
          "action": "parallel-delegate"
        },
        {
          "phase": "merge",
          "description": "合并结果",
          "action": "merge-results"
        }
      ]
    },
    {
      "name": "code-review",
      "description": "代码审查 - 安全、质量、性能审查",
      "keywords": ["code review", "review code", "代码审查"],
      "trigger": "keyword",
      "priority": 70,
      "dimensions": [
        "security",
        "performance",
        "code-quality",
        "maintainability"
      ],
      "output": {
        "format": "structured",
        "fields": ["score", "findings", "priorities", "suggestions"]
      }
    }
  ],
  "keywords": {
    "ralph": {
      "workflow": "ralph",
      "description": "持久循环直到完成"
    },
    "ralplan": {
      "workflow": "ralplan",
      "description": "计划审批流程"
    },
    "deep-interview": {
      "workflow": "deep-interview",
      "description": "Socratic 深度访谈"
    },
    "ultrawork": {
      "workflow": "ultrawork",
      "description": "并行执行"
    },
    "team": {
      "workflow": "team",
      "description": "团队协作模式"
    }
  }
}