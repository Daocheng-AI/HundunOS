{
  "version": "3.1.0",
  "name": "HundunOS",
  "environment": "windows",
  "kernel": {
    "logLevel": "info",
    "maxRetries": 3,
    "timeout": 30000
  },
  "modules": {
    "edict": {
      "enabled": true,
      "path": "stable-modules/edict"
    },
    "permission-gating": {
      "enabled": true,
      "path": "stable-modules/permission-gating"
    },
    "cowork-monitor": {
      "enabled": true,
      "path": "stable-modules/cowork-monitor"
    },
    "audit-logger": {
      "enabled": true,
      "path": "stable-modules/audit-logger"
    },
    "privacy-shield": {
      "enabled": true,
      "path": "stable-modules/privacy-shield"
    },
    "env-health-checker": {
      "enabled": true,
      "path": "stable-modules/env-health-checker"
    },
    "recoverable-memory": {
      "enabled": true,
      "path": "stable-modules/recoverable-memory"
    }
  },
  "modelRouter": {
    "defaultStrategy": "COST_FIRST",
    "providers": [
      "ollama",
      "qclaw",
      "openai",
      "anthropic",
      "glm",
      "custom"
    ],
    "localFirst": true,
    "endpoint": "http://127.0.0.1:11434",
    "localModel": "qwen2.5:1.5b",
    "localMaxTokens": 8192,
    "requestTimeout": 30000,
    "circuitBreaker": {
      "enabled": true,
      "threshold": 5,
      "timeout": 60000
    },
    "openai": {
      "apiKey": "",
      "endpoint": "https://api.openai.com/v1",
      "model": "gpt-4o-mini"
    },
    "anthropic": {
      "apiKey": "",
      "endpoint": "https://api.anthropic.com",
      "model": "claude-sonnet-4-20250514"
    },
    "glm": {
      "apiKey": "",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "defaultModel": "glm-4-flash"
    },
    "custom": [
      {
        "name": "my_model",
        "displayName": "我的自定义模型",
        "endpoint": "https://your-api.example.com/v1",
        "apiKey": "",
        "model": "your-model-name",
        "contextWindow": 8192,
        "costPer1M": 0,
        "capabilities": ["chat"]
      }
    ],
    "_custom_comment": "自定义模型配置。支持任意 OpenAI 兼容 API 端点。可配置多个模型"
  },

  "storage": {
    "type": "json",
    "path": "./data"
  },
  "messageBus": {
    "ackTimeout": 5000,
    "maxRetries": 3
  },
  "platform": {
    "os": "windows",
    "workspace": ".",
    "pythonPath": "python",
    "nodePath": "node"
  },

  "toolBridge": {
    "toolsDir": "./scripts/tools",
    "timeout": 30000
  },

  "upgrade": {
    "trustedSources": [
      "file:///C:/ProgramData/HundunOS/updates/",
      "file:///C:/ProgramData/HundunOS/releases/",
      "https://hundunos.local"
    ],
    "allowedPatterns": [
      "*.json",
      "*.js"
    ],
    "requireSignature": true,
    "requireHash": true,
    "targetVersion": "3.0.1"
  },

  "restApi": {
    "port": 38080,
    "apiKeys": [],
    "cors": {
      "allowedOrigins": [
        "http://localhost:38080",
        "http://127.0.0.1:38080"
      ],
      "allowCredentials": false,
      "maxAge": 86400
    }
  },

  "rateLimit": {
    "windowMs": 60000,
    "maxRequests": 60,
    "burstMax": 10
  },

  "healthMonitor": {
    "weights": {
      "kernel": 0.15,
      "memory": 0.12,
      "model_router": 0.12,
      "edict": 0.12,
      "security": 0.10,
      "storage": 0.10,
      "cron": 0.08,
      "mcp": 0.08,
      "workbuddy": 0.08,
      "network": 0.05
    },
    "alertThreshold": 60,
    "maxHistory": 50
  },

  "permissionMode": "default",
  "permissionRules": {
        "deny": [
            {
                "tool": "Bash",
                "commandPattern": "rm\\s+-rf\\s+/",
                "reason": "禁止删除根目录"
            },
            {
                "tool": "Bash",
                "commandPattern": "sudo\\s+rm",
                "reason": "禁止 sudo rm"
            },
            {
                "tool": "Bash",
                "commandPattern": "git\\s+push\\s+--force",
                "reason": "禁止强制推送"
            },
            {
                "tool": "Bash",
                "commandPattern": "DROP\\s+TABLE",
                "reason": "禁止删除数据表"
            }
        ],
        "ask": [
            {
                "tool": "Bash",
                "commandPattern": "npm\\s+publish"
            },
            {
                "tool": "Bash",
                "commandPattern": "git\\s+push"
            },
            {
                "tool": "Bash",
                "commandPattern": "kubectl\\s+delete"
            }
        ],
        "allow": [
            {
                "tool": "Bash",
                "commandPattern": "^(git status|git log|git diff|git branch)"
            },
            {
                "tool": "Bash",
                "commandPattern": "^(ls|cat|pwd|echo|which)"
            },
            {
                "tool": "Bash",
                "commandPattern": "^(npm test|npm run test)"
            }
        ]
    },

  "hooks": {},

  "skills": {
    "enabled": true,
    "dirs": [
      "./.claude/skills",
      "./skills"
    ]
  },

  "rustModules": {
    "enabled": true,
    "mode": "auto",
    "tcpPort": 38082,
    "socketPath": "\\\\.\\pipe\\hundunos",
    "fallbackToJS": true,
    "healthCheckInterval": 30000,
    "modules": {
      "tool":      "required",
      "memory":    "required",
      "router":    "optional",
      "policy":    "required",
      "scientist": "optional"
    }
  }
}