[
  {
    "name": "database_query",
    "type": "database",
    "action": "query",
    "description": "数据库查询（外部扩展意图）",
    "priority": 10,
    "caseInsensitive": true,
    "patterns": [
      "查询数据库",
      "SELECT.*FROM",
      "数据库.*统计",
      "db.*query"
    ],
    "extract": {
      "type": "sql_parser",
      "notes": "由 intent-engine 外部插件提供，无需修改源码即可增减意图"
    }
  },
  {
    "name": "container_manage",
    "type": "devops",
    "action": "container",
    "description": "容器管理（外部扩展意图）",
    "priority": 10,
    "caseInsensitive": true,
    "patterns": [
      "启动容器",
      "停止容器",
      "docker.*start",
      "docker.*stop",
      "k8s.*deploy"
    ],
    "extract": {
      "type": "container_parser"
    }
  },
  {
    "name": "ci_cd_trigger",
    "type": "devops",
    "action": "cicd",
    "description": "CI/CD 流水线触发",
    "priority": 10,
    "caseInsensitive": true,
    "patterns": [
      "触发构建",
      "运行流水线",
      "deploy.*production",
      "run.*pipeline"
    ],
    "extract": {
      "type": "cicd_parser"
    }
  }
]
