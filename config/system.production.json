{
  "version": "3.0.0",
  "name": "HundunOS",
  "environment": "production",
  "description": "HundunOS v3.0 生产环境配置",
  
  "kernel": {
    "logLevel": "info",
    "maxRetries": 3,
    "timeout": 30000,
    "enableMetrics": true,
    "enableProfiling": false
  },
  
  "modules": {
    "edict": {
      "enabled": true,
      "path": "stable-modules/edict",
      "autoSaveInterval": 30000
    },
    "permission-gating": {
      "enabled": true,
      "path": "stable-modules/permission-gating",
      "requireExplicitApproval": true,
      "defaultRequireApprovalLevel": 3
    },
    "cowork-monitor": {
      "enabled": true,
      "path": "stable-modules/cowork-monitor",
      "alertThreshold": 5,
      "cooldownMs": 60000
    },
    "audit-logger": {
      "enabled": true,
      "path": "stable-modules/audit-logger",
      "retentionDays": 90,
      "encryptLogs": true,
      "compressArchives": true
    },
    "privacy-shield": {
      "enabled": true,
      "path": "stable-modules/privacy-shield",
      "logRedaction": true,
      "autoBlockLevels": [4]
    },
    "env-health-checker": {
      "enabled": true,
      "path": "stable-modules/env-health-checker",
      "checkInterval": 300000,
      "alertOnDegradation": true
    },
    "recoverable-memory": {
      "enabled": true,
      "path": "stable-modules/recoverable-memory",
      "autoPersistInterval": 60000,
      "maxSizeBytes": 104857600
    }
  },
  
  "modelRouter": {
    "defaultStrategy": "COST_FIRST",
    "providers": ["ollama", "anthropic", "openai"],
    "localFirst": true,
    "endpoint": "http://127.0.0.1:11434",
    "localModel": "qwen2.5:1.5b",
    "localMaxTokens": 8192,
    "requestTimeout": 30000,
    "circuitBreaker": {
      "enabled": true,
      "threshold": 3,
      "timeout": 30000
    },
    "fallbackOrder": ["ollama", "anthropic", "openai"],
    "enableCache": true,
    "cacheTtlMs": 300000,
    "maxCacheSize": 500
  },
  
  "storage": {
    "type": "json",
    "path": "./data",
    "backupPath": "./backups",
    "backupInterval": 86400000,
    "maxBackups": 30,
    "encryptBackups": true
  },
  
  "messageBus": {
    "ackTimeout": 5000,
    "maxRetries": 3,
    "maxQueueSize": 1000,
    "enableDeadLetterQueue": true
  },
  
  "platform": {
    "os": "windows",
    "workspace": ".",
    "pythonPath": "python",
    "nodePath": "node",
    "maxMemoryUsagePercent": 80,
    "maxCpuUsagePercent": 70
  },
  
  "toolBridge": {
    "toolsDir": "../scripts/tools",
    "timeout": 30000,
    "enableSandbox": true,
    "maxConcurrentCalls": 10
  },
  
  "upgrade": {
    "trustedSources": [
      "file:///C:/ProgramData/HundunOS/updates/",
      "file:///C:/ProgramData/HundunOS/releases/",
      "https://hundunos.local"
    ],
    "allowedPatterns": ["*.json", "*.js"],
    "requireSignature": true,
    "requireHash": true,
    "requireVersionIncrease": true,
    "targetVersion": "3.0.1"
  },
  
  "restApi": {
    "port": 38081,
    "host": "0.0.0.0",
    "maxBodySize": 5242880,
    "cors": {
      "allowedOrigins": ["https://app.yourcompany.com", "https://admin.yourcompany.com"],
      "allowCredentials": false,
      "maxAge": 86400,
      "allowedHeaders": ["Content-Type", "Authorization", "X-API-Key"],
      "exposedHeaders": ["X-Request-Id", "X-RateLimit-Limit", "X-RateLimit-Remaining"]
    },
    "rateLimit": {
      "enabled": true,
      "windowMs": 60000,
      "maxRequests": 120,
      "burstMax": 20,
      "trustedProxies": ["127.0.0.1", "::1"]
    },
    "compression": {
      "enabled": true,
      "threshold": 1024
    },
    "securityHeaders": {
      "enabled": true,
      "hsts": {
        "maxAge": 31536000,
        "includeSubDomains": true,
        "preload": false
      },
      "contentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'",
      "xContentTypeOptions": "nosniff",
      "xFrameOptions": "DENY"
    }
  },
  
  "rateLimit": {
    "windowMs": 60000,
    "maxRequests": 120,
    "burstMax": 20,
    "global": true,
    "trustedIPs": ["127.0.0.1", "::1/128"]
  },
  
  "healthMonitor": {
    "weights": {
      "kernel": 0.15,
      "memory": 0.12,
      "model_router": 0.12,
      "edict": 0.12,
      "security": 0.10,
      "storage": 0.10,
      "cron": 0.08,
      "mcp": 0.08,
      "workbuddy": 0.08,
      "network": 0.05
    },
    "alertThreshold": 60,
    "maxHistory": 100,
    "checkInterval": 30000,
    "enableTelemetry": true
  },
  
  "logging": {
    "level": "info",
    "format": "json",
    "file": {
      "enabled": true,
      "path": "./logs",
      "maxSize": 10485760,
      "maxFiles": 10,
      "compress": true
    },
    "console": {
      "enabled": true,
      "pretty": false
    },
    "sentry": {
      "enabled": false,
      "dsn": "",
      "environment": "production"
    }
  },
  
  "metrics": {
    "enabled": true,
    "port": 38082,
    "path": "/metrics",
    "collectDefaultMetrics": true,
    "customMetrics": ["request_duration_seconds", "memory_usage_bytes"]
  },
  
  "sessions": {
    "maxSessions": 200,
    "sessionTimeout": 3600000,
    "cleanupInterval": 300000,
    "enableSessionEncryption": true
  },
  
  "performance": {
    "fileReadMaxSize": 10485760,
    "fileWriteMaxSize": 10485760,
    "maxRequestSize": 5242880,
    "enableResponseCompression": true,
    "connectionPoolSize": 10,
    "cacheEnabled": true,
    "cacheTtlMs": 300000
  }
}